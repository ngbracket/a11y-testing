{
  "name": "@ngbracket/a11y-testing",
  "version": "0.5.0",
  "description": "Accessibility helpers for Angular component tests in Vitest and TestBed: axe checks that name the owning component, key presses that do what the browser does, real Tab order, focus return and focus trap checks, computed names, tab-order snapshots, and live-region announcements.",
  "license": "MIT",
  "author": "Duncan Faulkner",
  "contributors": [
    "Lara Sanz"
  ],
  "homepage": "https://ngbracket.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngbracket/a11y-testing"
  },
  "bugs": {
    "url": "https://github.com/ngbracket/a11y-testing/issues"
  },
  "keywords": [
    "angular",
    "accessibility",
    "a11y",
    "testing",
    "vitest",
    "testbed",
    "aria-live",
    "ngbracket",
    "keyboard",
    "focus",
    "focus-trap",
    "accessible-name",
    "axe",
    "axe-core"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@types/node": "^26.5.0",
    "jsdom": "^30.0.1",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "axe-core": "^4.14.0"
  }
}

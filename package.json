{
  "name": "@ngbracket/a11y-testing",
  "version": "0.1.0",
  "description": "Test what an Angular component announces to screen readers (ARIA live regions, CDK LiveAnnouncer) in Vitest and TestBed, with zoneless-aware waiting.",
  "license": "MIT",
  "author": "Duncan Faulkner",
  "contributors": [
    "Lara Sanz"
  ],
  "homepage": "https://ngbracket.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngbracket/a11y-testing"
  },
  "keywords": [
    "angular",
    "accessibility",
    "a11y",
    "testing",
    "vitest",
    "testbed",
    "aria-live",
    "ngbracket"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
